        "concurrently": "^9.1.2",
        "nodemon": "^3.1.10",
        "prisma": "^6.7.0",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.15",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "@ffmpeg-installer/ffmpeg": "^1.1.0",
        "@ffmpeg/ffmpeg": "^0.12.15",
        "@ffprobe-installer/ffprobe": "^2.1.2",
        "@prisma/client": "^6.7.0",
        "@prisma/extension-accelerate": "^1.3.0",
        "@supabase/supabase-js": "^2.49.4",
        "cors": "^2.8.5",
        "dotenv": "^16.5.0",
        "express": "^5.1.0",
